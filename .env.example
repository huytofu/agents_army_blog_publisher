# Blog publisher storage
BLOG_S3_BUCKET=entourage-ai-life-website 
BLOG_IDEAS_PREFIX=blog/ideas/
BLOG_POSTS_FEED_KEY=blog/posts.json
BLOG_POSTS_PREFIX=blog/
BLOG_SITE_URL=https://www.entourage-ai.life
BLOG_RSS_KEY=blog/rss.xml
BLOG_SITEMAP_KEY=sitemap.xml
BLOG_ROBOTS_KEY=robots.txt
BLOG_STATIC_SITEMAP_PATHS=,blogs.html,features.html,privacy.html,terms.html,refund.html
BLOG_LOCAL_WORK_ROOT=/tmp/blog-work
BLOG_MAX_IDEAS_PER_RUN=1
BLOG_DRY_RUN=true
BLOG_OVERWRITE_EXISTING=false
BLOG_WEEKLY_HIGHLIGHT_KEY=blog/weekly-highlight.json

# Blog API (FastAPI + Mangum Lambda)
BLOG_API_JWT_SECRET=super_secret_entourage_blog_api_123
BLOG_API_JWT_ALGORITHM=HS256
BLOG_API_ACCESS_TOKEN_TTL_MINUTES=60
BLOG_API_CORS_ORIGINS=https://www.entourage-ai.life
BLOG_API_BASE_URL=https://461utcww9c.execute-api.ap-southeast-1.amazonaws.com

# Weekly digest / blog API (MongoDB subscribers, SES email sends)
BLOG_API_MONGODB_URI=
BLOG_API_MONGODB_USERNAME=
BLOG_API_MONGODB_PASSWORD=
BLOG_API_MONGODB_AUTH_MECHANISM=SCRAM-SHA-256
BLOG_API_MONGODB_REQUIRE_AUTH=true
BLOG_API_MONGODB_AUTH_SOURCE=admin
BLOG_API_MONGODB_DATABASE=entourage_blog
BLOG_API_SES_SENDER_EMAIL=
BLOG_API_SES_CONFIGURATION_SET=

# Comment moderation LLM (blog API)
BLOG_COMMENT_MODERATION_TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
BLOG_COMMENT_MODERATION_HF_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
BLOG_COMMENT_MODERATION_HF_PROVIDER=auto
BLOG_COMMENT_MODERATION_HF_FALLBACK_MODEL_IDS=
BLOG_COMMENT_MODERATION_LLM_MAX_TOKENS=256
BLOG_COMMENT_MODERATION_LLM_TEMPERATURE=0.1
BLOG_COMMENT_MODERATION_LLM_TOP_P=0.9
BLOG_COMMENT_MODERATION_LLM_TIMEOUT_SEC=30

# AWS region. Prefer Lambda execution-role credentials in production.
AWS_REGION=ap-southeast-1

# Main reasoning agent model config
BLOG_PIPELINE_TOGETHER_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507-tput
BLOG_PIPELINE_HF_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
BLOG_PIPELINE_HF_PROVIDER=auto
BLOG_PIPELINE_HF_FALLBACK_MODEL_IDS=Qwen/Qwen3-Coder-480B-A35B-Instruct,meta-llama/Meta-Llama-3-70B
BLOG_PIPELINE_LLM_MAX_TOKENS=4096
BLOG_PIPELINE_LLM_TEMPERATURE=0.3
BLOG_PIPELINE_LLM_TOP_P=0.9
BLOG_PIPELINE_LLM_TIMEOUT_SEC=90

# Expansion/writing agent model config
BLOG_EXPANSION_TOGETHER_MODEL=zai-org/GLM-5.2
BLOG_EXPANSION_HF_MODEL=zai-org/GLM-5.2
BLOG_EXPANSION_HF_PROVIDER=auto
BLOG_EXPANSION_HF_FALLBACK_MODEL_IDS=deepseek-ai/DeepSeek-V3.1
BLOG_EXPANSION_LLM_MAX_TOKENS=8192
BLOG_EXPANSION_LLM_TEMPERATURE=0.7
BLOG_EXPANSION_LLM_TOP_P=0.9
BLOG_EXPANSION_LLM_TIMEOUT_SEC=90
BLOG_EXPANSION_LLM_REASONING_EFFORT=low

# HTML/image subagent model config
BLOG_SUBAGENT_TOGETHER_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507-tput
BLOG_SUBAGENT_HF_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
BLOG_SUBAGENT_HF_PROVIDER=auto
BLOG_SUBAGENT_HF_FALLBACK_MODEL_IDS=Qwen/Qwen3-Coder-480B-A35B-Instruct,meta-llama/Meta-Llama-3-70B
BLOG_SUBAGENT_LLM_MAX_TOKENS=2048
BLOG_SUBAGENT_LLM_TEMPERATURE=0.4
BLOG_SUBAGENT_LLM_TOP_P=0.9
BLOG_SUBAGENT_LLM_TIMEOUT_SEC=90

# Provider API keys. Store real values in Lambda env/secrets, not in git.
BLOG_TOGETHER_API_KEY=your_together_api_key
BLOG_HUGGINGFACE_API_KEY=your_huggingface_api_key

# Image generation. Use `placeholder` only for dry-run plumbing.
BLOG_IMAGE_PROVIDER=together
BLOG_IMAGE_API_KEY=your_image_api_key
# Together image model choices:
# - ByteDance-Seed/Seedream-3.0
BLOG_IMAGE_MODEL=ByteDance-Seed/Seedream-3.0
BLOG_IMAGE_WIDTH=1200
BLOG_IMAGE_HEIGHT=630
BLOG_IMAGE_TIMEOUT_SEC=120

# Graph safety limits
BLOG_MAIN_AGENT_MAX_ROUNDS=3
BLOG_SUBAGENT_MAX_RETRIES=2

# Logging
LOG_LEVEL=INFO
